rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidSeatingPlan(data) {
      return data.keys().hasAll(['yearGroup', 'subject', 'classCode', 'seats', 'roomElements', 'updatedAt', 'ownerId'])
        && data.yearGroup is string && data.yearGroup.size() <= 100
        && data.subject is string && data.subject.size() <= 100
        && data.classCode is string && data.classCode.size() <= 100
        && data.seats is list && data.seats.size() <= 100
        && data.roomElements is list && data.roomElements.size() <= 100
        && data.updatedAt is timestamp
        && data.ownerId is string;
    }

    match /seatingPlans/{planId} {
      allow get: if isValidId(planId);
      
      allow create: if isSignedIn() 
        && isValidId(planId) 
        && isValidSeatingPlan(incoming())
        && incoming().ownerId == request.auth.uid
        && incoming().updatedAt == request.time;
        
      allow update: if isSignedIn()
        && isValidId(planId)
        && isValidSeatingPlan(incoming())
        && (
          // Allow owner to update
          (existing().ownerId == request.auth.uid)
          || 
          // Or allow update if PIN matches (if we want to allow cross-device sync without auth identity)
          (incoming().pin != null && incoming().pin == existing().pin)
        )
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time;

      allow delete: if isSignedIn() && existing().ownerId == request.auth.uid;
      
      allow list: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
